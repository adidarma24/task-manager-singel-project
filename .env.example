NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PENTING: Service Role key — JANGAN pakai prefix NEXT_PUBLIC_
# Ambil dari Project Settings > API > Secret keys (bagian "default")
# Kunci ini hanya dipakai di server (API route), tidak pernah dikirim ke browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
